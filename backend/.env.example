DATABASE_URL="file:./dev.db"

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/callback/google

# Allowed email domain (restrict signups)
ALLOWED_EMAIL_DOMAIN=vitbhopal.ac.in

# JWT (used for local login fallback)
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# NextAuth secret
AUTH_SECRET=your_nextauth_secret_change_in_production

# File upload (local disk path relative to project root)
UPLOAD_DIR=public/uploads

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# System actor ID (set after seed — default 1)
SYSTEM_USER_ID=1
