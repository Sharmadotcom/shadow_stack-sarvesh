// Prisma Schema — Campus Grievance Redressal & Maintenance Tracker

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}


// ─── Enums ────────────────────────────────────────────────────────────────────

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum Role {
  STUDENT
  STAFF
  DEPT_ADMIN
  SUPER_ADMIN
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Status {
  OPEN
  ACKNOWLEDGED
  IN_PROGRESS
  ESCALATED
  RESOLVED
  CLOSED
  REOPENED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id           Int          @id @default(autoincrement())
  name         String
  email        String       @unique
  passwordHash String?
  googleId     String?      @unique
  authProvider AuthProvider @default(LOCAL)
  role         Role         @default(STUDENT)
  department   String?
  isSystem     Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  ticketsRaised    Ticket[]             @relation("RaisedBy")
  ticketsAssigned  Ticket[]             @relation("AssignedTo")
  timelineEvents   TicketTimeline[]
  categoryTeams    CategoryTeamMember[]
  notifications    Notification[]
}

model Category {
  id              Int      @id @default(autoincrement())
  name            String   @unique
  slug            String   @unique
  defaultPriority Priority @default(MEDIUM)
  slaAckHours     Int
  slaResolveHours Int
  isRestricted    Boolean  @default(false) // e.g. Harassment/Safety
  createdAt       DateTime @default(now())

  tickets Ticket[]
  team    CategoryTeamMember[]
}

model Ticket {
  id                 Int       @id @default(autoincrement())
  ticketCode         String    @unique
  studentId          Int
  student            User      @relation("RaisedBy", fields: [studentId], references: [id])
  categoryId         Int
  category           Category  @relation(fields: [categoryId], references: [id])
  title              String
  description        String
  priority           Priority
  location           String
  status             Status    @default(OPEN)
  assignedToId       Int?
  assignedTo         User?     @relation("AssignedTo", fields: [assignedToId], references: [id])
  createdAt          DateTime  @default(now())
  acknowledgedAt     DateTime?
  resolvedAt         DateTime?
  closedAt           DateTime?
  reopenedAt         DateTime?
  slaDeadlineAck     DateTime
  slaDeadlineResolve DateTime
  isEscalated        Boolean   @default(false)
  escalationTier     Int       @default(1)
  resolutionNote     String?
  rating             Int?      // 1-5 student satisfaction rating

  attachments TicketAttachment[]
  timeline    TicketTimeline[]
}

model TicketAttachment {
  id         Int      @id @default(autoincrement())
  ticketId   Int
  ticket     Ticket   @relation(fields: [ticketId], references: [id])
  filePath   String
  fileName   String
  mimeType   String?
  uploadedAt DateTime @default(now())
}

model TicketTimeline {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  actorId   Int
  actor     User     @relation(fields: [actorId], references: [id])
  action    String   // e.g. CREATED, STATUS_CHANGED, ESCALATED, ASSIGNED, NOTE_ADDED
  oldStatus Status?
  newStatus Status?
  note      String?
  timestamp DateTime @default(now())
}

model CategoryTeamMember {
  id         Int      @id @default(autoincrement())
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])
  userId     Int
  user       User     @relation(fields: [userId], references: [id])

  @@unique([categoryId, userId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  ticketId  Int?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
